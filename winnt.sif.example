; Copy to winnt.sif and fill both REDACTED values locally.
; winnt.sif is gitignored and must never be committed.
;SetupMgrTag
[Data]
AutoPartition=1
MsDosInitiated="0"
UnattendedInstall="Yes"
AutomaticUpdates="Yes"

[Unattended]
UnattendMode=FullUnattended
UnattendSwitch = "Yes"
WaitForReboot = "No"
OemSkipEula=Yes
OemPreinstall=No
TargetPath=\WINDOWS

[GuiUnattended]
AdminPassword=REDACTED
EncryptedAdminPassword=No
OEMSkipRegional=1
OemSkipWelcome=1
TimeZone="(GMT) Coordinated Universal Time"

[UserData]
ProductKey=XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
FullName="winxp64-r290x"
OrgName="winxp64-r290x"
ComputerName=WINXP64R290X

[Display]
BitsPerPel=32
Xresolution=1024
YResolution=768

[RegionalSettings]
LanguageGroup=1
Language=00000409
SystemLocale=00000409
UserLocale=00000409
InputLocale=0409

[Identification]
JoinWorkgroup=WORKGROUP

[Networking]
InstallDefaultComponents=Yes
