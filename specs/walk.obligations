# walk.obligations -- disposition for every `allium plan` obligation of walk.allium.
# Gate: host-lifecycle obligations specs/walk.allium --tests tests --strict-discharge
#   <id> => test:<name> [exercises=<symbol>] | structural | waived: <reason>
# `structural` is only ever a declared shape: field presence and types, an optional
# field's two cases, a declared terminal or rejected transition, a surface's actor.
# Nothing behavioural is dispositioned structural, because the check lane does not
# discharge behaviour and a relabel is the dodge this gate exists to catch.
#
# Two laws carry this spec. THE CLAMP is measured at the command file, not at a
# function's argument, because the collector forwards whatever it is asked and only the reader
# clamps. THE ALTERNATION LAW is discharged across the seam: the retry policy lives in `kd_read`
# and the fact that makes a retry worth sending lives on the wire, so one walk obligation names a
# wire test.

entity-fields.ByteArray                                  => structural
transition-edge.BlockWalk.walking.complete               => test:test_a_walk_of_exactly_the_limit_is_one_step exercises=read_block
transition-edge.BlockWalk.walking.partial                => test:test_a_stalled_walk_reports_where_it_stopped exercises=read_block
transition-rejected.BlockWalk.status                     => structural
transition-terminal.BlockWalk.status                     => structural
entity-fields.BlockWalk                                  => structural
when-presence.Read.bytes                                 => structural
transition-edge.Read.unanswered.answered                 => test:test_a_read_that_arrives_is_not_retried_at_all exercises=kd_read
transition-edge.Read.unanswered.refused                  => test:test_an_answered_refusal_is_not_retried exercises=kd_read
transition-edge.Read.unanswered.stalled                  => test:test_silence_retriggers_the_read_exactly_once exercises=kd_read
transition-rejected.Read.status                          => structural
transition-terminal.Read.status                          => structural
invariant.Read.StepWithinTheEngineLimit                  => test:test_no_request_asks_for_more_than_the_limit_across_a_whole_walk exercises=MAXRD
invariant.Read.StepIsNotEmpty                            => test:test_a_zero_length_read_is_never_issued exercises=read_block
invariant.Read.AttemptsWithinTheBound                    => test:test_silence_retriggers_the_read_exactly_once exercises=kd_read
invariant.Read.RefusalIsDefinitive                       => test:test_an_answered_refusal_is_not_retried exercises=_last_ret
invariant.Read.SilenceIsTriedTwice                       => test:test_silence_retriggers_the_read_exactly_once exercises=Waiting
entity-fields.Read                                       => structural
entity-optional.Read.bytes                               => structural
entity-fields.Attempt                                    => structural
config-default.max_step_length                           => test:test_a_read_is_clamped_to_the_length_the_engine_answers exercises=MAXRD
config-default.max_attempts                              => test:test_silence_retriggers_the_read_exactly_once exercises=kd_read
rule-success.BeginTheWalk                                => test:test_a_read_is_clamped_to_the_length_the_engine_answers exercises=MAXRD
rule-failure.BeginTheWalk.1                              => test:test_a_zero_length_read_is_never_issued exercises=read_block
rule-entity-creation.BeginTheWalk.1                      => test:test_a_walk_of_exactly_the_limit_is_one_step exercises=BlockWalk
rule-entity-creation.BeginTheWalk.2                      => test:test_a_read_is_clamped_to_the_length_the_engine_answers exercises=MAXRD
